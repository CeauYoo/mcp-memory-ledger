{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future authorized same-model experiment record (not generated by proxy harness)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "fixture_sha256", "task_id", "variant", "model", "sampling", "budget", "prompt_sha256", "answer", "evaluation", "observed_latency_ms", "usage", "cost", "trace_ref"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "fixture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "task_id": {"type": "string"},
    "variant": {"enum": ["A_no_memory", "B_recall", "C_feedback_corrected", "C_minus_correction", "C_minus_retrieval", "C_minus_byte_budget"]},
    "model": {"type": "object", "required": ["provider", "id", "version"], "properties": {"provider": {"type": "string"}, "id": {"type": "string"}, "version": {"type": ["string", "null"]}}},
    "sampling": {"type": "object", "required": ["temperature", "seed", "replicate"], "properties": {"temperature": {"type": "number"}, "seed": {"type": ["integer", "null"]}, "replicate": {"type": "integer", "minimum": 0}}},
    "budget": {"type": "object", "required": ["max_output_tokens", "max_tool_calls", "max_turns"], "properties": {"max_output_tokens": {"type": "integer", "minimum": 1}, "max_tool_calls": {"type": "integer", "minimum": 0}, "max_turns": {"type": "integer", "minimum": 1}}},
    "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "answer": {"type": "string"},
    "evaluation": {"type": "object", "required": ["task_success", "incorrect_revision", "rubric_version", "judge"], "properties": {"task_success": {"type": ["boolean", "null"]}, "incorrect_revision": {"type": ["boolean", "null"]}, "rubric_version": {"type": "string"}, "judge": {"type": "string"}}},
    "observed_latency_ms": {"type": "number", "minimum": 0},
    "usage": {"type": ["object", "null"], "description": "Provider-reported actual input/output/cached/reasoning token counts with source; null if unavailable. Never bytes/4 estimates."},
    "cost": {"type": ["object", "null"], "description": "Measured/billed amount and currency, or explicit price schedule/date and actual usage; null if unavailable."},
    "trace_ref": {"type": "string", "description": "Local evidence reference; redact credentials and private data."}
  }
}
